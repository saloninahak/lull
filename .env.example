# copy what you need. nothing here is secret: the site's values end up in
# the page anyone can read, and the server's are only addresses.

# --- the site (vercel → project → settings → environment variables) ---
# where the room server lives. without it, the site looks for rooms at its
# own address (fine for `pnpm dev` and `pnpm host`, not for vercel).
VITE_ROOM_URL=https://lull-rooms.onrender.com
# the address behind `email me` on home. leave empty to hide the link.
VITE_CONTACT_EMAIL=

# --- the room server (render → service → environment) ---
# which sites may use it. a * matches one part of an address, so the second
# entry covers every vercel preview.
ALLOWED_ORIGINS=https://lull.vercel.app,https://lull-*.vercel.app
# behind render's proxy, read the visitor's address from its headers
TRUST_PROXY=1
HOST=0.0.0.0
# PORT is set by render
